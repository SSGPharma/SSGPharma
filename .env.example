# Runtime
NODE_ENV=development # required: development or production
PORT=3000 # optional: HTTP listen port; defaults to 3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000 # required in production; canonical absolute HTTP(S) URL
NEXT_PUBLIC_ASSET_PREFIX= # optional: static asset prefix, normally empty
NEXT_PUBLIC_GA_ID= # optional: Google Analytics measurement ID
NEXT_DEPLOYMENT_ID= # optional: unique build deployment identifier

# Database (required; relative SQLite paths resolve from prisma/schema.prisma)
DATABASE_URL="file:./dev.db" # local example; use file:/srv/ssgpharma/shared/data/prod.db in production

# Admin auth
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters # required in production (SESSION_SECRET is legacy fallback)
SESSION_SECRET= # optional legacy secret name; use only during transition if ADMIN_SESSION_SECRET is absent
ADMIN_PASSWORD=replace-me # optional bootstrap only when no AdminUser row exists
RENDER_RUNTIME_MIGRATIONS=false # legacy Render only; leave false for Lightsail

# Upload storage (optional; local disk is the default)
STORAGE_DRIVER=local # local or s3; S3 is opt-in only
UPLOADS_DIR=data/uploads # optional local upload directory; set to persistent shared storage in production
NEXT_PUBLIC_CDN_URL= # required with S3; HTTPS public CDN base URL
AWS_REGION= # required only with S3; use instance role credentials
S3_BUCKET= # required only with S3
S3_ENDPOINT= # optional S3-compatible endpoint

# Backups (required only for deploy/backup.sh)
BACKUP_BUCKET= # S3 bucket name for SQLite and upload backups

# Image storage (optional; defaults to local disk)
STORAGE_DRIVER=local
# Local uploads directory (relative to app cwd unless absolute); persistent in production
UPLOADS_DIR=data/uploads
# Public CDN base URL for S3 image objects, e.g. https://cdn.example.com
NEXT_PUBLIC_CDN_URL=
# Required only when STORAGE_DRIVER=s3; use instance IAM credentials when deployed on AWS
AWS_REGION=
S3_BUCKET=
# Optional S3-compatible endpoint (e.g. for local development)
S3_ENDPOINT=
